import { eq } from "drizzle-orm";
import type { PostgresJsDatabase } from "drizzle-orm/postgres-js";
import { assertDecisionAuthorityRevision, stableDecisionAuthority, type DecisionAuthorityRevision } from "../../relation/decision-authority";
import { assertDecisionContextRevision, stableDecisionContext, type DecisionContextRevision } from "../../relation/decision-context";
import { assertDecisionRecord, createDecisionRecord, stableDecisionRecord, type DecisionRecord } from "../../relation/decision-record";
import { assertRecommendationProposal, type RecommendationProposal, type RecommendationProposalRepository } from "../../relation/recommendation-proposal";
import { decisionAuthorityRevisions,decisionContextEvidenceReferences,decisionContextRevisions,decisionContextSubjectReferences,decisionRecordSubjectReferences,decisionRecords } from "./postgres-schema";

const fail=(code:string):never=>{throw new Error(code)};
const equal=(left:readonly unknown[],right:readonly unknown[])=>left.length===right.length&&left.every((item,index)=>item===right[index]);
export interface DecisionAuthorityRevisionRepository {getDecisionAuthorityRevisionById(id:string):Promise<DecisionAuthorityRevision|null>;persistDecisionAuthorityRevision(value:DecisionAuthorityRevision):Promise<DecisionAuthorityRevision>}
export interface DecisionContextRevisionRepository {getDecisionContextRevisionById(id:string):Promise<DecisionContextRevision|null>;persistDecisionContextRevision(value:DecisionContextRevision):Promise<DecisionContextRevision>}
export interface DecisionRecordRepository {getDecisionRecordById(id:string):Promise<DecisionRecord|null>;persistDecisionRecord(value:DecisionRecord):Promise<DecisionRecord>}

/** Exact DAR reads compare durable columns with the canonical immutable payload; they never repair corrupted authority state. */
export class PostgresDecisionAuthorityRevisionRepository implements DecisionAuthorityRevisionRepository {
  constructor(private readonly database:PostgresJsDatabase){}
  async getDecisionAuthorityRevisionById(id:string):Promise<DecisionAuthorityRevision|null>{const rows=await this.database.select().from(decisionAuthorityRevisions).where(eq(decisionAuthorityRevisions.decisionAuthorityRevisionId,id)).limit(1);if(!rows.length)return null;try{const row=rows[0],value=row.payload;assertDecisionAuthorityRevision(value);if(row.decisionAuthorityRevisionId!==value.decisionAuthorityRevisionId||row.actorId!==value.actorId||row.authorityScope!==value.authorityScope||row.authorityEvidenceRef!==value.authorityEvidenceRef||row.schemaVersion!==value.schemaVersion||row.createdAt!==value.createdAt)fail("ERR_DECISION_AUTHORITY_REVISION_PERSISTENCE_FAILED");return structuredClone(value)}catch{return fail("ERR_DECISION_AUTHORITY_REVISION_PERSISTENCE_FAILED")}}
  async persistDecisionAuthorityRevision(value:DecisionAuthorityRevision):Promise<DecisionAuthorityRevision>{assertDecisionAuthorityRevision(value);const existing=await this.getDecisionAuthorityRevisionById(value.decisionAuthorityRevisionId);if(existing){if(stableDecisionAuthority(existing)!==stableDecisionAuthority(value))fail("ERR_DECISION_AUTHORITY_REVISION_PERSISTENCE_FAILED");return existing}await this.database.insert(decisionAuthorityRevisions).values({decisionAuthorityRevisionId:value.decisionAuthorityRevisionId,actorId:value.actorId,authorityScope:value.authorityScope,authorityEvidenceRef:value.authorityEvidenceRef,schemaVersion:value.schemaVersion,createdAt:value.createdAt,payload:structuredClone(value)}).onConflictDoNothing();const reread=await this.getDecisionAuthorityRevisionById(value.decisionAuthorityRevisionId);if(!reread||stableDecisionAuthority(reread)!==stableDecisionAuthority(value))fail("ERR_DECISION_AUTHORITY_REVISION_PERSISTENCE_FAILED");return reread}
}

/** DCTXREV validates exact historical DAR/RCP witnesses and raw normalized rows; the database side is never deduplicated before comparison. */
export class PostgresDecisionContextRevisionRepository implements DecisionContextRevisionRepository {
  constructor(private readonly database:PostgresJsDatabase,private readonly authorities:DecisionAuthorityRevisionRepository,private readonly proposals:RecommendationProposalRepository){}
  private async witnesses(value:DecisionContextRevision):Promise<RecommendationProposal>{const authority=await this.authorities.getDecisionAuthorityRevisionById(value.decisionAuthorityRevisionId),proposal=await this.proposals.getRecommendationProposalById(value.recommendationProposalId);if(!authority||!proposal)fail("ERR_DECISION_CONTEXT_REVISION_PERSISTENCE_FAILED");assertDecisionAuthorityRevision(authority);assertRecommendationProposal(proposal);if(value.decisionSubjectItemOrdinals.some(ordinal=>proposal.items[ordinal]===undefined))fail("ERR_DECISION_CONTEXT_REVISION_PERSISTENCE_FAILED");return proposal}
  async getDecisionContextRevisionById(id:string):Promise<DecisionContextRevision|null>{const rows=await this.database.select().from(decisionContextRevisions).where(eq(decisionContextRevisions.decisionContextRevisionId,id)).limit(1);if(!rows.length)return null;try{const row=rows[0],value=row.payload;assertDecisionContextRevision(value);if(row.decisionContextRevisionId!==value.decisionContextRevisionId||row.recommendationProposalId!==value.recommendationProposalId||row.decisionAuthorityRevisionId!==value.decisionAuthorityRevisionId||row.schemaVersion!==value.schemaVersion||row.createdAt!==value.createdAt)fail("ERR_DECISION_CONTEXT_REVISION_PERSISTENCE_FAILED");const [subjects,evidence]=await Promise.all([this.database.select().from(decisionContextSubjectReferences).where(eq(decisionContextSubjectReferences.decisionContextRevisionId,id)),this.database.select().from(decisionContextEvidenceReferences).where(eq(decisionContextEvidenceReferences.decisionContextRevisionId,id))]);if(!equal(value.decisionSubjectItemOrdinals,subjects.map(row=>row.sourceOrdinal).sort((left,right)=>left-right))||!equal(value.contextEvidenceRefs,evidence.map(row=>row.evidenceRef).sort()))fail("ERR_DECISION_CONTEXT_REVISION_PERSISTENCE_FAILED");await this.witnesses(value);return structuredClone(value)}catch{return fail("ERR_DECISION_CONTEXT_REVISION_PERSISTENCE_FAILED")}}
  async persistDecisionContextRevision(value:DecisionContextRevision):Promise<DecisionContextRevision>{assertDecisionContextRevision(value);const existing=await this.getDecisionContextRevisionById(value.decisionContextRevisionId);if(existing){if(stableDecisionContext(existing)!==stableDecisionContext(value))fail("ERR_DECISION_CONTEXT_REVISION_PERSISTENCE_FAILED");return existing}await this.witnesses(value);await this.database.insert(decisionContextRevisions).values({decisionContextRevisionId:value.decisionContextRevisionId,recommendationProposalId:value.recommendationProposalId,decisionAuthorityRevisionId:value.decisionAuthorityRevisionId,schemaVersion:value.schemaVersion,createdAt:value.createdAt,payload:structuredClone(value)}).onConflictDoNothing();for(const ordinal of value.decisionSubjectItemOrdinals)await this.database.insert(decisionContextSubjectReferences).values({referenceId:`${value.decisionContextRevisionId}:subject:${ordinal}`,decisionContextRevisionId:value.decisionContextRevisionId,sourceOrdinal:ordinal}).onConflictDoNothing();for(const evidenceRef of value.contextEvidenceRefs)await this.database.insert(decisionContextEvidenceReferences).values({referenceId:`${value.decisionContextRevisionId}:evidence:${evidenceRef}`,decisionContextRevisionId:value.decisionContextRevisionId,evidenceRef}).onConflictDoNothing();const reread=await this.getDecisionContextRevisionById(value.decisionContextRevisionId);if(!reread||stableDecisionContext(reread)!==stableDecisionContext(value))fail("ERR_DECISION_CONTEXT_REVISION_PERSISTENCE_FAILED");return reread}
}

/** DCR exact reads re-run the frozen T11 matrix against the exact historical RCP; a durable record never supplies authority by itself. */
export class PostgresDecisionRecordRepository implements DecisionRecordRepository {
  constructor(private readonly database:PostgresJsDatabase,private readonly contexts:DecisionContextRevisionRepository,private readonly authorities:DecisionAuthorityRevisionRepository,private readonly proposals:RecommendationProposalRepository){}
  private async witnesses(value:DecisionRecord):Promise<void>{try{const [context,authority,proposal]=await Promise.all([this.contexts.getDecisionContextRevisionById(value.decisionContextRevisionId),this.authorities.getDecisionAuthorityRevisionById(value.decisionAuthorityRevisionId),this.proposals.getRecommendationProposalById(value.recommendationProposalId)]);if(!context||!authority||!proposal)fail("ERR_DECISION_RECORD_PERSISTENCE_FAILED");assertDecisionContextRevision(context);assertDecisionAuthorityRevision(authority);assertRecommendationProposal(proposal);if(context.recommendationProposalId!==value.recommendationProposalId||context.decisionAuthorityRevisionId!==value.decisionAuthorityRevisionId||!equal(context.decisionSubjectItemOrdinals,value.decisionSubjectItemOrdinals))fail("ERR_DECISION_RECORD_PERSISTENCE_FAILED");const rebuilt=createDecisionRecord(context,proposal,{decisionDisposition:value.decisionDisposition,decisionDeclaration:value.decisionDeclaration,createdAt:value.createdAt});if(stableDecisionRecord(rebuilt)!==stableDecisionRecord(value))fail("ERR_DECISION_RECORD_PERSISTENCE_FAILED")}catch{fail("ERR_DECISION_RECORD_PERSISTENCE_FAILED")}}
  async getDecisionRecordById(id:string):Promise<DecisionRecord|null>{const rows=await this.database.select().from(decisionRecords).where(eq(decisionRecords.decisionRecordId,id)).limit(1);if(!rows.length)return null;try{const row=rows[0],value=row.payload;assertDecisionRecord(value);if(row.decisionRecordId!==value.decisionRecordId||row.decisionContextRevisionId!==value.decisionContextRevisionId||row.recommendationProposalId!==value.recommendationProposalId||row.decisionAuthorityRevisionId!==value.decisionAuthorityRevisionId||row.decisionDisposition!==value.decisionDisposition||row.decisionDeclaration!==value.decisionDeclaration||row.schemaVersion!==value.schemaVersion||row.createdAt!==value.createdAt)fail("ERR_DECISION_RECORD_PERSISTENCE_FAILED");const subjects=await this.database.select().from(decisionRecordSubjectReferences).where(eq(decisionRecordSubjectReferences.decisionRecordId,id));if(!equal(value.decisionSubjectItemOrdinals,subjects.map(row=>row.sourceOrdinal).sort((left,right)=>left-right)))fail("ERR_DECISION_RECORD_PERSISTENCE_FAILED");await this.witnesses(value);return structuredClone(value)}catch{return fail("ERR_DECISION_RECORD_PERSISTENCE_FAILED")}}
  async persistDecisionRecord(value:DecisionRecord):Promise<DecisionRecord>{assertDecisionRecord(value);const existing=await this.getDecisionRecordById(value.decisionRecordId);if(existing){if(stableDecisionRecord(existing)!==stableDecisionRecord(value))fail("ERR_DECISION_RECORD_PERSISTENCE_FAILED");return existing}await this.witnesses(value);await this.database.insert(decisionRecords).values({decisionRecordId:value.decisionRecordId,decisionContextRevisionId:value.decisionContextRevisionId,recommendationProposalId:value.recommendationProposalId,decisionAuthorityRevisionId:value.decisionAuthorityRevisionId,decisionDisposition:value.decisionDisposition,decisionDeclaration:value.decisionDeclaration,schemaVersion:value.schemaVersion,createdAt:value.createdAt,payload:structuredClone(value)}).onConflictDoNothing();for(const ordinal of value.decisionSubjectItemOrdinals)await this.database.insert(decisionRecordSubjectReferences).values({referenceId:`${value.decisionRecordId}:subject:${ordinal}`,decisionRecordId:value.decisionRecordId,sourceOrdinal:ordinal}).onConflictDoNothing();const reread=await this.getDecisionRecordById(value.decisionRecordId);if(!reread||stableDecisionRecord(reread)!==stableDecisionRecord(value))fail("ERR_DECISION_RECORD_PERSISTENCE_FAILED");return reread}
}
