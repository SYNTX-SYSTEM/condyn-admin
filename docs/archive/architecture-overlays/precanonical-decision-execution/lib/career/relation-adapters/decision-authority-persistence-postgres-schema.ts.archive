import { jsonb,integer,pgTable,text } from "drizzle-orm/pg-core";
import type { DecisionAuthorityRevision } from "../../relation/decision-authority";
import type { DecisionContextRevision } from "../../relation/decision-context";
import type { DecisionRecord } from "../../relation/decision-record";

export const decisionAuthorityRevisions=pgTable("decision_authority_revisions",{decisionAuthorityRevisionId:text("decision_authority_revision_id").primaryKey(),actorId:text("actor_id").notNull(),authorityScope:text("authority_scope").notNull(),authorityEvidenceRef:text("authority_evidence_ref").notNull(),schemaVersion:text("schema_version").notNull(),createdAt:text("created_at").notNull(),payload:jsonb("payload").$type<DecisionAuthorityRevision>().notNull()});
export const decisionContextRevisions=pgTable("decision_context_revisions",{decisionContextRevisionId:text("decision_context_revision_id").primaryKey(),recommendationProposalId:text("recommendation_proposal_id").notNull(),decisionAuthorityRevisionId:text("decision_authority_revision_id").notNull().references(()=>decisionAuthorityRevisions.decisionAuthorityRevisionId,{onDelete:"restrict"}),schemaVersion:text("schema_version").notNull(),createdAt:text("created_at").notNull(),payload:jsonb("payload").$type<DecisionContextRevision>().notNull()});
export const decisionContextSubjectReferences=pgTable("decision_context_subject_references",{referenceId:text("reference_id").primaryKey(),decisionContextRevisionId:text("decision_context_revision_id").notNull().references(()=>decisionContextRevisions.decisionContextRevisionId,{onDelete:"restrict"}),sourceOrdinal:integer("source_ordinal").notNull()});
export const decisionContextEvidenceReferences=pgTable("decision_context_evidence_references",{referenceId:text("reference_id").primaryKey(),decisionContextRevisionId:text("decision_context_revision_id").notNull().references(()=>decisionContextRevisions.decisionContextRevisionId,{onDelete:"restrict"}),evidenceRef:text("evidence_ref").notNull()});
export const decisionRecords=pgTable("decision_records",{decisionRecordId:text("decision_record_id").primaryKey(),decisionContextRevisionId:text("decision_context_revision_id").notNull().references(()=>decisionContextRevisions.decisionContextRevisionId,{onDelete:"restrict"}),recommendationProposalId:text("recommendation_proposal_id").notNull(),decisionAuthorityRevisionId:text("decision_authority_revision_id").notNull().references(()=>decisionAuthorityRevisions.decisionAuthorityRevisionId,{onDelete:"restrict"}),decisionDisposition:text("decision_disposition").notNull(),decisionDeclaration:text("decision_declaration").notNull(),schemaVersion:text("schema_version").notNull(),createdAt:text("created_at").notNull(),payload:jsonb("payload").$type<DecisionRecord>().notNull()});
export const decisionRecordSubjectReferences=pgTable("decision_record_subject_references",{referenceId:text("reference_id").primaryKey(),decisionRecordId:text("decision_record_id").notNull().references(()=>decisionRecords.decisionRecordId,{onDelete:"restrict"}),sourceOrdinal:integer("source_ordinal").notNull()});
