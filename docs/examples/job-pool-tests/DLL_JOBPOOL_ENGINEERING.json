  "roles": [
    {
      "id": "role_kestrel_fullstack",
      "pool_id": "pool_dll_engineering_v1",
      "organization_id": "org_kestrel",
      "title": "Senior Full-Stack Engineer – Shipment Tracking",
      "seniority": "Senior / L4",
      "domain_focus": "Web Platforms",
      "description": "Kestrel's tracking team owns the live shipment view that dispatchers and end customers use around the clock. You build features end to end: a React and TypeScript front end with map visualisation, Node.js services that consume carrier telematics events from Kafka, and the PostgreSQL read models behind them. Typical work includes designing a new exception-handling flow for delayed loads, reducing the time-to-first-position for new shipments, and hardening the public tracking link against abuse. You pair with product design on interaction details, write the tests that keep releases boring, and take part in a one-week-in-six on-call rotation. We expect several years of production web development, comfort across the stack, and the judgement to keep a growing codebase understandable for the next engineer."
    },
    {
      "id": "role_kestrel_frontend_architect",
      "pool_id": "pool_dll_engineering_v1",
      "organization_id": "org_kestrel",
      "title": "Frontend Architect",
      "seniority": "Staff / L5",
      "domain_focus": "Frontend Architecture",
      "description": "Six product teams contribute to one dispatcher application that has grown to 400k lines of TypeScript. As Frontend Architect you define how it evolves: module boundaries and a micro-frontend or modular-monolith strategy, the shared design system, performance budgets for low-end warehouse terminals, and accessibility conformance for public-sector customers. You write architecture decision records, review the hardest pull requests, build proofs of concept before teams commit, and coach senior engineers. You do not manage people but you are accountable for the technical health of the front end and for a migration plan away from a legacy Angular module that still handles carrier settlement."
    },
    {
      "id": "role_kestrel_engineering_lead",
      "pool_id": "pool_dll_engineering_v1",
      "organization_id": "org_kestrel",
      "title": "Engineering Lead – Routing Platform",
      "seniority": "Lead / M1",
      "domain_focus": "Engineering Management",
      "description": "The routing team (seven engineers, one product manager) owns the route optimisation service that plans 40,000 stops a day. As Engineering Lead you are responsible for the team's delivery and people: hiring, one-to-ones, growth plans and a healthy on-call. You stay technical enough to steer design reviews of the optimisation pipeline (a Go service wrapping an OR-Tools solver) and to challenge estimates, and you translate between dispatch operations and engineering when planning quality degrades. You set quarterly goals with product, report on reliability and delivery, and work with the other leads on cross-team architecture. Prior people leadership is expected; a background in backend or optimisation systems helps."
    },
    {
      "id": "role_aurelion_principal_architect",
      "pool_id": "pool_dll_engineering_v1",
      "organization_id": "org_aurelion",
      "title": "Principal Software Architect – Clinical Platform",
      "seniority": "Principal / L6",
      "domain_focus": "Enterprise Architecture",
      "description": "Aurelion is consolidating three generations of clinical products (a Java EE patient record, a .NET medication module and newer Spring Boot services) into one clinical platform. The Principal Architect owns the target architecture and the roadmap to reach it: domain decomposition along clinical bounded contexts, an integration backbone, data ownership, and the non-functional envelope (availability for 24/7 wards, auditability, data residency per country). You chair the architecture board, work with regulatory affairs on how architecture choices affect MDR documentation, and guide twelve teams through the transition without disrupting hospitals in production. Expect to present to the executive board and to hospital CIOs, and to write the reference documentation others build on."
    },
    {
      "id": "role_aurelion_security_engineer",
      "pool_id": "pool_dll_engineering_v1",
      "organization_id": "org_aurelion",
      "title": "Security Engineer – Clinical Systems",
      "seniority": "Senior / L4",
      "domain_focus": "Application Security",
      "description": "Hospitals are a target. In the product security team you protect Aurelion's clinical applications across their lifecycle: threat modelling new features with the teams, running and tuning SAST, dependency and container scanning in CI, coordinating penetration tests, and owning the vulnerability management process including customer advisories. You review authentication and authorisation designs (SAML and OIDC with hospital identity providers, break-glass access on wards), help teams fix findings rather than just reporting them, and contribute the security sections of the regulatory documentation. Occasional support of hospital security teams during incidents is part of the role."
    },
    {
      "id": "role_aurelion_backend_interop",
      "pool_id": "pool_dll_engineering_v1",
      "organization_id": "org_aurelion",
      "title": "Backend Engineer – Interoperability Gateway",
      "seniority": "Mid / L3",
      "domain_focus": "Backend Services",
      "description": "The interoperability gateway connects Aurelion's patient record to laboratory systems, radiology, billing and national e-health services. As a backend engineer you build and maintain the gateway's Spring Boot services: mapping HL7 v2 messages to FHIR resources, implementing new interfaces for hospital customers, making message flows observable and replayable, and keeping throughput stable when a large hospital comes online. You will spend real time reading interface specifications and debugging message traces with customer integration teams. Clean, tested Java and an interest in healthcare data standards matter more than prior hospital experience."
    },
    {
      "id": "role_brightwater_cloud_platform",
      "pool_id": "pool_dll_engineering_v1",
      "organization_id": "org_brightwater",
      "title": "Cloud Platform Engineer",
      "seniority": "Senior / L4",
      "domain_focus": "Cloud Infrastructure",
      "description": "The platform team provides Brightwater's 30 service teams with a paved road on AWS: multi-account landing zone, EKS clusters, networking with strict segmentation for the cardholder data environment, and self-service infrastructure modules. You design and code infrastructure in Terraform, operate Kubernetes at scale (cluster upgrades without merchant impact, autoscaling for peak sales days), build golden paths in our internal developer portal, and work with security and compliance on PCI DSS and DORA controls. You are on the platform on-call rotation and write the runbooks that make it calm."
    },
    {
      "id": "role_brightwater_devops",
      "pool_id": "pool_dll_engineering_v1",
      "organization_id": "org_brightwater",
      "title": "DevOps Engineer – Release & Reliability",
      "seniority": "Mid / L3",
      "domain_focus": "Delivery & Reliability",
      "description": "Brightwater deploys more than 80 times a day while keeping payment authorisation available. In the release and reliability team you own the CI/CD system (GitHub Actions and Argo CD), progressive delivery with canaries and automatic rollback, and the observability stack (Prometheus, Grafana, OpenTelemetry). You define service level objectives with product teams, run game days, and improve incident tooling. Expect to automate toil away with scripts and small services, and to explain to engineers why a deployment was stopped."
    },
    {
      "id": "role_brightwater_backend_ledger",
      "pool_id": "pool_dll_engineering_v1",
      "organization_id": "org_brightwater",
      "title": "Backend Engineer – Ledger",
      "seniority": "Senior / L4",
      "domain_focus": "Financial Systems",
      "description": "Every euro that moves through Brightwater is recorded in the ledger: a double-entry accounting service written in Kotlin on PostgreSQL, with strict consistency, auditability and reconciliation against banks and card schemes. You design ledger features such as multi-currency settlement and merchant reserves, keep posting latency low under peak load, and write the reconciliation jobs that finance relies on. Correctness beats cleverness here: you will reason about idempotency, transactional boundaries and failure modes, and document them so auditors can follow."
    }
  ],
